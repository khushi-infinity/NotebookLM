# Get your free key at https://console.groq.com
GROQ_API_KEY="gsk_your_api_key_here"

# Local Qdrant (Docker). For Qdrant Cloud: https://xyz.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Optional for Qdrant Cloud projects with API key enabled
QDRANT_API_KEY=""

# Express server port
PORT=3000
